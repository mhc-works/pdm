#!/usr/bin/env bash
# Last gate before anything leaves this machine: the whole tree, the commits being pushed (messages,
# author and committer lines) and the test suite. Skipping it with --no-verify is never right here.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  python3 tools/check_public.py --range "$range" || fail=1
done
python3 tools/check_public.py || fail=1
python3 -m unittest discover -s tests -q || fail=1
[ "$fail" = 0 ] || { echo "pre-push: refused, nothing pushed" >&2; exit 1; }
