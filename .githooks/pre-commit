#!/usr/bin/env bash
# Refuses a commit that would publish something private or secret. Enable once per clone:
#   git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
python3 tools/check_public.py --staged || fail=1
if command -v gitleaks >/dev/null; then
  gitleaks protect --staged --redact --no-banner || fail=1
else
  echo "pre-commit: gitleaks is not installed, skipped here (CI runs it)" >&2
fi
[ "$fail" = 0 ] || { echo "pre-commit: refused, nothing committed" >&2; exit 1; }
